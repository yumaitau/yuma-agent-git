# GitHub OAuth (login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Yuma sign-in (issue #27): OIDC providers JSON, one secret per provider id,
# the TOTP seed encryption key, and who may mint SCIM tokens. See docs/deploy.md.
OIDC_PROVIDERS=
OIDC_GOOGLE_CLIENT_SECRET=
TOTP_ENCRYPTION_KEY=
SCIM_ADMIN_USER_IDS=
REQUIRE_MFA_FOR_TOKENS=

# GitHub App (repo bridge)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# HMAC key for signed cache tokens (issue #21). Any long random string.
CACHE_SIGNING_KEY=

# CI secrets and OIDC (issue #50). Generate with scripts/ci-keys.mjs; see docs/ci-oidc-aws.md.
SECRETS_KEK=
CI_OIDC_SIGNING_KEYS=
CI_OIDC_ISSUER=
SECRETS_ADMIN_USER_IDS=
