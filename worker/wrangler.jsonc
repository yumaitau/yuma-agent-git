{
  // yuma-agent-git — Cloudflare Worker (Hono).
  // No plaintext secrets in this file (CI greps for key material).
  "name": "yuma-agent-git",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/webhooks/*",
      "/healthz",
      "/*.git/*",
      "/ci/oidc/*",
      "/runner/*",
      // package registry (#53)
      "/v2/*",
      "/npm/*",
      // MCP (#56): the consent page is a browser navigation, which would get the SPA
      "/mcp",
      "/oauth/*",
      "/.well-known/oauth-*",
      // signed unsubscribe links in notification email (#44)
      "/notifications/unsubscribe",
    ],
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_als"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yag-db",
      // Yuma IT production database; local development uses Wrangler's local store.
      "database_id": "3fb9a764-2131-46b5-827f-8d7626d26016",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "yag-objects",
    },
    // Backups (issue #70), local only: production binds a bucket in a
    // separate account once one exists (docs/operations/backup-dr.md).
    { "binding": "BACKUPS", "bucket_name": "yag-backups" },
  ],
  "queues": {
    "producers": [
      { "binding": "CI_QUEUE", "queue": "ci-runs" },
      {
        "binding": "DERIVED_QUEUE",
        "queue": "derived-data",
      },
      {
        "binding": "AGENT_QUEUE",
        "queue": "agent-jobs",
      },
      {
        "binding": "IMPORT_QUEUE",
        "queue": "git-import",
      },
      { "binding": "AUDIT_QUEUE", "queue": "audit-stream" },
      { "binding": "EVENTS_QUEUE", "queue": "forge-events" },
      { "binding": "MIRROR_QUEUE", "queue": "mirror-sync" },
      { "binding": "NOTIFY_QUEUE", "queue": "notifications" },
    ],
    "consumers": [
      // per-org pools (#52) admit the jobs; up to 20 run at once, the container default max_instances
      {
        "queue": "ci-runs",
        "max_batch_size": 1,
        "max_concurrency": 20,
        "max_retries": 0,
      },
      {
        "queue": "derived-data",
        "max_batch_size": 10,
        "max_retries": 3,
      },
    ],
  },
  // Workers AI has no local simulator — declaring `ai` at the top level makes
  // the vitest plugin proxy it to Cloudflare (tests would need an API token).
  // Production deploys enable it with `wrangler deploy --env prod` (the env
  // block below); the gateway fails gracefully without the binding.
  "vars": { "CI_ENABLED": "false", "CI_MONTHLY_BUDGET_USD": "5" },
  "env": {
    "prod": {
      "vars": { "CI_ENABLED": "true", "CI_MONTHLY_BUDGET_USD": "5" },
      "containers": [
        {
          "class_name": "CiRunnerDO",
          "scheduling_policy": "durable_object",
          "images": { "ci": { "dockerfile": "./runner/Dockerfile" } },
          "observability": { "enabled": false },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "yag-db",
          "database_id": "3fb9a764-2131-46b5-827f-8d7626d26016",
        },
      ],
      "r2_buckets": [{ "binding": "OBJECTS", "bucket_name": "yag-objects" }],
      "durable_objects": {
        "bindings": [
          { "name": "CI_RUNNER", "class_name": "CiRunnerDO" },
          { "name": "REF_LOCK", "class_name": "RefLockDO" },
          { "name": "AGENT", "class_name": "YagAgent" },
          { "name": "SUPERFAN", "class_name": "SuperfanDO" },
          { "name": "RATE_LIMIT", "class_name": "RateLimitDO" },
          { "name": "MERGE_QUEUE", "class_name": "MergeQueueDO" },
        ],
      },
      "queues": {
        "producers": [
          { "binding": "CI_QUEUE", "queue": "ci-runs" },
          { "binding": "DERIVED_QUEUE", "queue": "derived-data" },
          { "binding": "AGENT_QUEUE", "queue": "agent-jobs" },
          { "binding": "IMPORT_QUEUE", "queue": "git-import" },
          { "binding": "AUDIT_QUEUE", "queue": "audit-stream" },
          { "binding": "EVENTS_QUEUE", "queue": "forge-events" },
          { "binding": "MIRROR_QUEUE", "queue": "mirror-sync" },
          { "binding": "NOTIFY_QUEUE", "queue": "notifications" },
        ],
        "consumers": [
          {
            "queue": "ci-runs",
            "max_batch_size": 1,
            // per-org pools (#52) admit the jobs; up to 20 run at once, the container default max_instances
            "max_concurrency": 20,
            "max_retries": 0,
          },
          { "queue": "derived-data", "max_batch_size": 10, "max_retries": 3 },
          { "queue": "agent-jobs", "max_batch_size": 5, "max_retries": 3 },
          { "queue": "git-import", "max_batch_size": 1, "max_retries": 3 },
          // in-order delivery: one consumer; the cron kick resumes after drops
          {
            "queue": "audit-stream",
            "max_batch_size": 10,
            "max_concurrency": 1,
            "max_retries": 10,
          },
          // webhook fan-out and delivery; retries are scheduled as new messages
          { "queue": "forge-events", "max_batch_size": 10, "max_retries": 3 },
          // one sync per invocation; a held mirror retries the message later
          { "queue": "mirror-sync", "max_batch_size": 1, "max_retries": 10 },
          // notification fan-out (#44): inbox rows and email claims make retries safe
          { "queue": "notifications", "max_batch_size": 10, "max_retries": 5 },
        ],
      },
      "ai": {
        "binding": "AI",
      },
    },
  },
  "durable_objects": {
    "bindings": [
      { "name": "CI_RUNNER", "class_name": "CiRunnerDO" },
      {
        "name": "REF_LOCK",
        "class_name": "RefLockDO",
      },
      {
        "name": "AGENT",
        "class_name": "YagAgent",
      },
      {
        "name": "SUPERFAN",
        "class_name": "SuperfanDO",
      },
      {
        "name": "RATE_LIMIT",
        "class_name": "RateLimitDO",
      },
      { "name": "MERGE_QUEUE", "class_name": "MergeQueueDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RefLockDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["YagAgent"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["SuperfanDO"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["RateLimitDO"],
    },
    { "tag": "v5", "new_sqlite_classes": ["CiRunnerDO"] },
    { "tag": "v6", "new_sqlite_classes": ["MergeQueueDO"] },
  ],
}
