{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "vite",
    "deploy": "npm run build && bash ../scripts/setup-queues.sh && wrangler d1 migrations apply yag-db --remote --env prod && wrangler deploy --env prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --config dashboard/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dashboard.json --noEmit",
    "lint": "eslint src test dashboard",
    "build": "vite build && node ../scripts/check-bundle-size.mjs && node ../scripts/check-dashboard-startup.mjs",
    "build:dashboard": "npm run build",
    "docs:api": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gen-api-docs.ts",
    "bench:policy": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-policy.ts",
    "bench:secrets": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bench-secrets.ts",
    "bench:endpoints": "vitest run test/perf-budgets.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "agents": "^0.28.1",
    "cron-schedule": "^6.0.0",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@octokit/rest": "^22.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.0"
  }
}
